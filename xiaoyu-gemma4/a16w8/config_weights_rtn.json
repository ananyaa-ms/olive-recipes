{
    "input_model": { "type": "HfModel", "model_path": "google/gemma-4-E2B-it" },
    "systems": {
        "local_system": {
            "type": "LocalSystem",
            "accelerators": [
                {
                    "device": "gpu",
                    "execution_providers": [
                        "CUDAExecutionProvider"
                    ]
                }
            ]
        }
    },
    "data_configs": [
        {
            "name": "cauldron_vision_calibration",
            "user_script": "user_script.py",
            "load_dataset_config": {
                "type": "cauldron_calibration_dataset",
                "subsets": [
                    "vqav2",
                    "visual7w",
                    "ai2d",
                    "chartqa",
                    "docvqa",
                    "textvqa",
                    "screen2words",
                    "scienceqa"
                ],
                "samples_per_subset": 16,
                "seed": 42,
                "shuffle_buffer_size": 0,
                "max_soft_tokens": 280
            },
            "dataloader_config": {
                "type": "no_auto_batch_dataloader"
            }
        }
    ],
    "passes": {
        "mobius_build": {
            "type": "MobiusBuilder",
            "precision": "fp32",
            "components_to_export": ["vision_encoder"]
        },
        "weights_rtn": {
            "type": "OnnxBlockWiseRtnQuantization",
            "bits": 4,
            "block_size": 128,
            "is_symmetric": true,
            "accuracy_level": 4,
            "save_as_external_data": true,
            "external_data_name": "model.onnx.data"
        },
        "matmul_nbits_to_qdq": {
            "type": "MatMulNBitsToQDQ",
            "use_signed_int": false,
            "add_zero_point": true,
            "save_as_external_data": true,
            "external_data_name": "model.onnx.data"
        },
        "graph_surgeries": {
            "type": "GraphSurgeries",
            "surgeries": [{"surgeon": "RemoveUnusedOutputs"},
                          {"surgeon": "SimplifiedLayerNormToL2Norm"},
                          {"surgeon": "RMSNormalizationToL2Norm"}],
            "save_as_external_data": true,
            "external_data_name": "model.onnx.data"
        },
        "a16w8_static_quantization": {
            "type": "OnnxStaticQuantization",
            "data_config": "cauldron_vision_calibration",
            "activation_type": "uint16",
            "precision": "uint8",
            "quant_format": "QDQ",
            "calibrate_method": "MinMax",
            "calibration_providers": [
                "CUDAExecutionProvider"
            ],
            "quant_preprocess": false,
            "prepare_qdq_config": true,
            "save_as_external_data": true,
            "external_data_name": "model.onnx.data"
        },
        "dynamic_to_fixed_shape": {
            "type": "DynamicToFixedShape",
            "dim_param": [
                "component.vision_encoder.num_patches"
            ],
            "dim_value": [
                2520
            ],
            "save_as_external_data": true,
            "external_data_name": "model.onnx.data"
        }
    },
    "host": "local_system",
    "target": "local_system",
    "cache_dir": "cache",
    "output_dir": "models/a16w8",
    "no_artifacts": true,
    "log_severity_level": 1
}
